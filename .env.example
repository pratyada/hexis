# Copy this file to .env.local and fill in your values

# Database (SQLite — no setup needed)
DATABASE_URL="file:./hexis.db"

# JWT Secret — change this to a random string in production
JWT_SECRET="hexis-law-crm-super-secret-key-change-me"

# Anthropic Claude API — required for AI drafting & research
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# NIC eCourts API — for live court case sync
# Register at: https://services.ecourts.gov.in
NIC_ECOURTS_API_KEY=""

# Google Vision API — enhanced OCR (optional, falls back to Tesseract)
GOOGLE_VISION_API_KEY=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HEXIS Law"

# SCC Online credentials (for reference — direct browser login)
SCC_ONLINE_USERNAME=""
SCC_ONLINE_PASSWORD=""

# Manupatra credentials (for reference — direct browser login)
MANUPATRA_USERNAME=""
MANUPATRA_PASSWORD=""
