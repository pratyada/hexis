generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          String    @default("ASSOCIATE") // OWNER, PARTNER, ASSOCIATE, CLERK, ADMIN
  avatar        String?
  phone         String?
  barCouncilNo  String?
  designation   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases         Case[]         @relation("AssignedLawyer")
  drafts        Draft[]
  documents     Document[]
  hearings      Hearing[]      @relation("HearingLawyer")
  notes         Note[]
  tasks         Task[]
  auditLogs     AuditLog[]

  @@index([email])
}

// ─── CLIENTS ────────────────────────────────────────────────────────────────

model Client {
  id            String    @id @default(cuid())
  clientCode    String    @unique
  name          String
  nameHindi     String?
  email         String?
  phone         String
  alternatePhone String?
  address       String?
  city          String?
  state         String?   @default("Delhi")
  pincode       String?
  pan           String?
  aadhaar       String?
  occupation    String?
  clientType    String    @default("INDIVIDUAL") // INDIVIDUAL, CORPORATE, NGO, GOVERNMENT
  companyName   String?
  gstin         String?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases         Case[]
  documents     Document[]
  drafts        Draft[]

  @@index([clientCode])
  @@index([phone])
  @@index([name])
}

// ─── CASES ──────────────────────────────────────────────────────────────────

model Case {
  id              String    @id @default(cuid())
  caseCode        String    @unique
  caseTitle       String
  cnrNumber       String?   @unique  // Court Case Number (NIC eCourts unique ID)
  caseNumber      String?            // e.g. "W.P.(C) 1234/2024"
  caseType        String             // CIVIL, CRIMINAL, WRIT, ARBITRATION, CONSUMER, LABOUR
  courtName       String?
  courtState      String?   @default("Delhi")
  courtDistrict   String?
  benchType       String?            // HC, DC, SC, TRIBUNAL
  filingDate      DateTime?
  registrationDate DateTime?
  status          String    @default("ACTIVE") // ACTIVE, DISPOSED, WITHDRAWN, TRANSFERRED
  stage           String?            // ADMISSION, HEARING, ARGUMENTS, JUDGMENT

  // Parties
  petitioner      String
  respondent      String
  petitionerAdvocate String?
  respondentAdvocate String?

  // Internal
  clientId        String
  lawyerId        String
  retainerAmount  Float?
  isPaid          Boolean   @default(false)
  priority        String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  tags            String?   // JSON array stored as string
  description     String?

  // NIC Sync
  lastNicSync     DateTime?
  nicRawData      String?   // JSON from NIC API

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client          Client    @relation(fields: [clientId], references: [id])
  lawyer          User      @relation("AssignedLawyer", fields: [lawyerId], references: [id])
  hearings        Hearing[]
  documents       Document[]
  drafts          Draft[]
  notes           Note[]
  tasks           Task[]
  orders          CourtOrder[]

  @@index([cnrNumber])
  @@index([caseCode])
  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
}

// ─── HEARINGS ───────────────────────────────────────────────────────────────

model Hearing {
  id              String    @id @default(cuid())
  caseId          String
  lawyerId        String
  hearingDate     DateTime
  hearingTime     String?
  courtRoom       String?
  purpose         String?   // ADMISSION, ARGUMENTS, EVIDENCE, JUDGMENT, COMPLIANCE
  status          String    @default("SCHEDULED") // SCHEDULED, COMPLETED, ADJOURNED, CANCELLED
  outcome         String?
  nextDate        DateTime?
  notes           String?
  complianceItems String?   // JSON: list of compliance tasks from last order
  reminderSent    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  case            Case      @relation(fields: [caseId], references: [id])
  lawyer          User      @relation("HearingLawyer", fields: [lawyerId], references: [id])

  @@index([caseId])
  @@index([hearingDate])
  @@index([lawyerId])
}

// ─── COURT ORDERS ───────────────────────────────────────────────────────────

model CourtOrder {
  id              String    @id @default(cuid())
  caseId          String
  orderDate       DateTime
  orderType       String?   // INTERIM, FINAL, NOTICE, SUMMONS
  orderText       String?   // Full text of order
  complianceRequired Boolean @default(false)
  complianceItems String?   // JSON array of compliance points
  complianceDeadline DateTime?
  complianceStatus String?  @default("PENDING")
  documentId      String?   // Link to scanned order document
  createdAt       DateTime  @default(now())

  case            Case      @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

// ─── DOCUMENTS ──────────────────────────────────────────────────────────────

model Document {
  id              String    @id @default(cuid())
  documentCode    String    @unique
  name            String
  originalName    String
  fileType        String    // PDF, JPEG, PNG, DOCX, etc.
  filePath        String    // local storage path
  fileSize        Int?
  mimeType        String?

  // Classification
  category        String    @default("GENERAL")
  // PETITION, AFFIDAVIT, ORDER, JUDGEMENT, AGREEMENT, NOTICE, VAKALATNAMA, EVIDENCE, ID_PROOF, OTHER
  language        String?   @default("en")

  // OCR & AI Analysis
  ocrText         String?   // Extracted text via Tesseract/Vision API
  ocrStatus       String?   @default("PENDING") // PENDING, PROCESSING, DONE, FAILED
  aiSummary       String?   // AI-generated summary
  aiKeyFacts      String?   // JSON: extracted key facts
  aiAnalysis      String?   // Full AI legal analysis

  // Relations
  clientId        String?
  caseId          String?
  uploadedBy      String
  isPublic        Boolean   @default(false)
  tags            String?   // JSON array

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client          Client?   @relation(fields: [clientId], references: [id])
  case            Case?     @relation(fields: [caseId], references: [id])
  uploader        User      @relation(fields: [uploadedBy], references: [id])

  @@index([clientId])
  @@index([caseId])
  @@index([category])
  @@index([documentCode])
}

// ─── DRAFTS ─────────────────────────────────────────────────────────────────

model Draft {
  id              String    @id @default(cuid())
  draftCode       String    @unique
  title           String
  draftType       String    // PETITION, REPLY, REJOINDER, APPLICATION, NOTICE, AGREEMENT, VAKALATNAMA, AFFIDAVIT, PLAINT
  language        String    @default("en") // en, hi, en-hi (bilingual)

  // Content
  content         String?   // Final draft content (Markdown/HTML)
  aiGenerated     Boolean   @default(false)
  aiModel         String?
  promptUsed      String?
  referencesCited String?   // JSON: list of SCC/Manupatra case references used

  // Input sources
  sourceDocumentIds String? // JSON: document IDs used as input
  factsSummary    String?   // Facts the user provided
  reliefSought    String?
  lawsApplicable  String?   // JSON: relevant acts/sections

  // State
  status          String    @default("DRAFT") // DRAFT, REVIEW, APPROVED, FILED
  version         Int       @default(1)

  // Relations
  clientId        String?
  caseId          String?
  createdBy       String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client          Client?   @relation(fields: [clientId], references: [id])
  case            Case?     @relation(fields: [caseId], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  versions        DraftVersion[]

  @@index([caseId])
  @@index([clientId])
  @@index([draftCode])
}

model DraftVersion {
  id        String   @id @default(cuid())
  draftId   String
  version   Int
  content   String
  savedAt   DateTime @default(now())
  savedBy   String?

  draft     Draft    @relation(fields: [draftId], references: [id])
}

// ─── LEGAL DATABASE ─────────────────────────────────────────────────────────

model LegalPrecedent {
  id              String    @id @default(cuid())
  caseTitle       String
  citation        String    @unique  // e.g. "AIR 2023 SC 1234"
  court           String?
  year            Int?
  judgmentDate    DateTime?
  bench           String?
  judges          String?

  // Content
  headnotes       String?
  judgmentText    String?   // Full judgment text
  holdingsSummary String?   // AI-generated key holdings
  legalPoints     String?   // JSON: key legal points
  actsReferred    String?   // JSON: acts and sections

  // Source
  source          String?   // SCC, MANUPATRA, INDIANKANOON, MANUAL
  sourceUrl       String?

  // Search
  keywords        String?   // Comma-separated for FTS
  practiceArea    String?   // CIVIL, CRIMINAL, CONSTITUTIONAL, LABOUR, CONSUMER, etc.

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([citation])
  @@index([year])
  @@index([practiceArea])
}

// ─── NOTES ──────────────────────────────────────────────────────────────────

model Note {
  id        String    @id @default(cuid())
  content   String
  noteType  String    @default("GENERAL") // GENERAL, STRATEGY, CLIENT_INSTRUCTION, RESEARCH, COMPLIANCE
  caseId    String?
  authorId  String
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case      Case?     @relation(fields: [caseId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([caseId])
}

// ─── TASKS ──────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  taskType    String    @default("GENERAL") // COMPLIANCE, FILING, RESEARCH, CLIENT_CALL, COURT_FEE, GENERAL
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, DONE, OVERDUE
  dueDate     DateTime?
  caseId      String?
  assignedTo  String
  reminderAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case        Case?     @relation(fields: [caseId], references: [id])
  assignee    User      @relation(fields: [assignedTo], references: [id])

  @@index([caseId])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([status])
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // CREATE, UPDATE, DELETE, VIEW, EXPORT
  entity    String   // Case, Client, Document, Draft, etc.
  entityId  String?
  details   String?  // JSON
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
